// StateKit Vue 包开发时类型配置
// 1. 作用：为 Vue SFC 和 Vite 客户端类型提供开发时 IDE 支持
// 2. 只用于 typecheck 和编辑器推断，不用于构建输出（构建走 tsconfig.build.json）
// 3. 维护要点：如需新增全局类型，在此声明；构建产物路径和 paths 映射在 tsconfig.build.json 中管理
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
