// StateKit 共享包构建配置
// 1. 作用：声明 shared 包的 TypeScript 编译参数
// 2. 将 src/ 编译到 dist/，输出类型声明文件（.d.ts）和 source map
// 3. 维护要点：新增或重命名导出时，确认 dist/ 类型路径与 packages/vue/tsconfig.build.json 中的 paths 映射对齐
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
