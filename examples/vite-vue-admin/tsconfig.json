// StateKit example app 类型配置
// 1. 作用：为 examples/vite-vue-admin 提供 TypeScript 类型检查支持
// 2. 配合 Vite 和 Vue SFC，让 example app 的 TS 环境与 docs 站保持一致
// 3. 维护要点：example 只通过公开包入口消费 StateKit，不要在这里添加直接指向 packages/ 源码的路径别名
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"]
}
