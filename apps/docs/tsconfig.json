// StateKit docs 站类型配置
// 1. 作用：为 apps/docs 提供 TypeScript 类型检查支持
// 2. 通过 vite/client 类型让 docs 内可以直接使用 Vite 环境变量和导入语法，同时识别 .vue SFC
// 3. 维护要点：如果新增全局类型或路径别名，在 compilerOptions 里声明，不要随意展开 include 范围
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"]
}
